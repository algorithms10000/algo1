///|
/// Explicit finite-field Galois theory. The ambient extension is
/// F_(p^n)/F_p and its automorphism group is cyclic, generated by x↦x^p.
#derive(Eq, Debug)
pub struct Automorphism {
  field : @field.FiniteField
  exponent : Int32
}

///|
pub extend Automorphism with Eq::{equal, not_equal}

///|
pub extend Automorphism with @debug.Debug::{to_repr}

///|
pub fn Automorphism::new(
  field : @field.FiniteField,
  exponent : Int32,
) -> Automorphism {
  let n = field.degree()
  {
    field,
    exponent: @linalg.residue(exponent.to_int64(), n.to_int64()).to_int(),
  }
}

///|
pub fn Automorphism::exponent(self : Automorphism) -> Int32 {
  self.exponent
}

///|
pub fn Automorphism::apply(
  self : Automorphism,
  element : @field.Element,
) -> @field.Element raise {
  if element.field() != self.field {
    raise @field.FieldError::FieldMismatch
  }
  element.frobenius_power(self.exponent.to_int64())
}

///|
pub fn Automorphism::compose(
  self : Automorphism,
  right : Automorphism,
) -> Automorphism raise {
  if self.field != right.field {
    raise @field.FieldError::FieldMismatch
  }
  Automorphism::new(self.field, self.exponent + right.exponent)
}

///|
pub fn Automorphism::inverse(self : Automorphism) -> Automorphism {
  Automorphism::new(self.field, -self.exponent)
}

///|
pub fn Automorphism::order(self : Automorphism) -> Int32 {
  let n = self.field.degree()
  let mut a = n
  let mut b = self.exponent
  while b != 0 {
    let remainder = a % b
    a = b
    b = remainder
  }
  n / a
}

///|
fn gcd(a : Int32, b : Int32) -> Int32 {
  let mut x = a
  let mut y = b
  while y != 0 {
    let remainder = x % y
    x = y
    y = remainder
  }
  x
}

///|
fn divisors(value : Int32) -> Array[Int32] {
  let result : Array[Int32] = []
  let mut divisor = 1
  while divisor <= value / divisor {
    if value % divisor == 0 {
      result.push(divisor)
      if divisor != value / divisor {
        result.push(value / divisor)
      }
    }
    divisor += 1
  }
  result.sort()
  result
}

///|
/// H_d=<phi^d>, Fix(H_d)=F_(p^d), for d|n. The stored basis is an
/// F_p-basis computed as ker(F^d-I), not a predefined answer.
#derive(Debug)
pub struct SubfieldCorrespondence {
  ambient : @field.FiniteField
  degree : Int32
  basis : Array[@field.Element]
}

///|
pub extend SubfieldCorrespondence with @debug.Debug::{to_repr}

///|
pub fn SubfieldCorrespondence::new(
  ambient : @field.FiniteField,
  degree : Int32,
) -> SubfieldCorrespondence raise {
  let n = ambient.degree()
  if degree <= 0 || n % degree != 0 {
    raise @field.FieldError::InvalidSubfieldDegree(degree, n)
  }
  let p = ambient.characteristic()
  let matrix = try! ambient.frobenius_matrix().power(degree.to_int64())
  let difference = try! matrix.subtract(try! @linalg.Matrix::identity(n, p))
  let kernel = try! difference.kernel()
  if kernel.length() != degree {
    raise @field.FieldError::DimensionMismatch(kernel.length(), degree)
  }
  let basis : Array[@field.Element] = []
  for vector in kernel {
    basis.push(try! ambient.element(Array::from_iter(vector.iter())))
  }
  { ambient, degree, basis, }
}

///|
pub fn SubfieldCorrespondence::degree(self : SubfieldCorrespondence) -> Int32 {
  self.degree
}

///|
pub fn SubfieldCorrespondence::basis(
  self : SubfieldCorrespondence,
) -> Array[@field.Element] {
  self.basis.copy()
}

///|
pub fn SubfieldCorrespondence::subgroup_generator(
  self : SubfieldCorrespondence,
) -> Automorphism {
  Automorphism::new(self.ambient, self.degree)
}

///|
pub fn SubfieldCorrespondence::subgroup_order(
  self : SubfieldCorrespondence,
) -> Int32 {
  self.ambient.degree() / self.degree
}

///|
pub fn SubfieldCorrespondence::contains(
  self : SubfieldCorrespondence,
  element : @field.Element,
) -> Bool raise {
  if element.field() != self.ambient {
    raise @field.FieldError::FieldMismatch
  }
  let fixed = try! element.frobenius_power(self.degree.to_int64())
  element == fixed
}

///|
/// Intersection of subfields corresponds to the join of fixed-group subgroups.
pub fn SubfieldCorrespondence::intersection_degree(
  self : SubfieldCorrespondence,
  other : SubfieldCorrespondence,
) -> Int32 raise {
  if self.ambient != other.ambient {
    raise @field.FieldError::FieldMismatch
  }
  gcd(self.degree, other.degree)
}

///|
/// Compositum of subfields corresponds to intersection of subgroups.
pub fn SubfieldCorrespondence::compositum_degree(
  self : SubfieldCorrespondence,
  other : SubfieldCorrespondence,
) -> Int32 raise {
  if self.ambient != other.ambient {
    raise @field.FieldError::FieldMismatch
  }
  let g = gcd(self.degree, other.degree)
  self.degree / g * other.degree
}

///|
pub fn SubfieldCorrespondence::subgroup_join_exponent(
  self : SubfieldCorrespondence,
  other : SubfieldCorrespondence,
) -> Int32 raise {
  if self.ambient != other.ambient {
    raise @field.FieldError::FieldMismatch
  }
  gcd(self.degree, other.degree)
}

///|
pub fn SubfieldCorrespondence::subgroup_intersection_exponent(
  self : SubfieldCorrespondence,
  other : SubfieldCorrespondence,
) -> Int32 raise {
  self.compositum_degree(other)
}

///|
/// Complete inclusion-reversing correspondence for a finite-field extension.
pub fn subfield_lattice(
  ambient : @field.FiniteField,
) -> Array[SubfieldCorrespondence] {
  let result : Array[SubfieldCorrespondence] = []
  for degree in divisors(ambient.degree()) {
    result.push(try! SubfieldCorrespondence::new(ambient, degree))
  }
  result
}
